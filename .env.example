# =============================================================================
# SIMCBP / MCBP-MIS — Environment Template
# Copy to `.env` (git-ignored) and fill per environment. NEVER commit real
# secrets, production credentials, API keys, or government integration tokens.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_NAME="SIMCBP — MCBP-MIS"
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- API (apps/api) ----
API_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1

# ---- Database (PostgreSQL + PostGIS) ----
# Placeholder DSN — replace with a provisioned instance. Do not use in prod.
DATABASE_URL=postgresql://simcbp:simcbp@localhost:5432/simcbp?schema=public

# ---- Auth / Security ----
# Generate strong, environment-specific values. These are NOT real secrets.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
MFA_ISSUER="MCBP-MIS"

# ---- Redis (queues / sessions) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3-compatible, document/evidence store) ----
STORAGE_PROVIDER=mock
STORAGE_BUCKET=simcbp-dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- AI assistant (M09) — advisory only, mock by default ----
AI_PROVIDER=mock
AI_API_KEY=

# ---- External / government integrations (M06) — mock until provisioned ----
INTEGRATION_MODE=sandbox
